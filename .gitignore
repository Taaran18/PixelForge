backend/models/*.pb
backend/models/*.onnx
backend/models/*.caffemodel
backend/models/*.prototxt
~/.u2net/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs & coverage ───────────────────────────────────────────────────────────
*.log
htmlcov/
